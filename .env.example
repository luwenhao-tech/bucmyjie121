# DeepSeek 配置（默认）
LLM_API_KEY=sk-your-deepseek-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# RAG 论文检索配置（可选）
# PAPERS_DIR=papers          # 论文 PDF 存放目录
# CHROMA_DIR=chroma_db       # 向量数据库存储目录
# RAG_CHUNK_SIZE=500         # 文本块大小（字符数）
# RAG_CHUNK_OVERLAP=100      # 相邻块重叠字符数
# RAG_TOP_K=5                # 每次检索返回的片段数
# RAG_SIMILARITY_THRESHOLD=0.3  # 相似度阈值
